<mxfile host="app.diagrams.net"><diagram name="Ops dashboard · one update, from a product to the screen"><mxGraphModel dx="1200" dy="900" grid="0" background="#0f141c" page="1" pageWidth="1300" pageHeight="1184"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Ops dashboard · one update, from a product to the screen" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#eef2f7;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="34" as="geometry"/></mxCell><mxCell id="lg0" value="Product" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg1" value="Intake program" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg2" value="Database" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#2a1f3d;strokeColor=#b48cff;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg3" value="Screen + alerts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#173326;strokeColor=#5fd38d;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg4" value="Decision / note" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;A product sends an update:&lt;/b&gt; a sale,&lt;br&gt;a sign-up, a reply or an error." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="380" height="74" as="geometry"/></mxCell><mxCell id="a" value="It goes to the &lt;b&gt;intake program&lt;/b&gt;, carrying&lt;br&gt;that product's own secret key." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="244" width="380" height="74" as="geometry"/></mxCell><mxCell id="q0" value="Does the key match&lt;br&gt;a known product?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="358" width="300" height="120" as="geometry"/></mxCell><mxCell id="b" value="The &lt;b&gt;key decides which product&lt;/b&gt; it is;&lt;br&gt;the update can't claim to be another." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="518" width="380" height="74" as="geometry"/></mxCell><mxCell id="q1" value="Is the update&lt;br&gt;in the right shape?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="632" width="300" height="120" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Saved once, never edited.&lt;/b&gt; A repeat&lt;br&gt;of the same update is ignored." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#2a1f3d;strokeColor=#b48cff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="792" width="380" height="74" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;A phone alert&lt;/b&gt; for each saved update,&lt;br&gt;unless the product sent its own." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#173326;strokeColor=#5fd38d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="906" width="380" height="74" as="geometry"/></mxCell><mxCell id="z" value="&lt;b&gt;The owner sees it&lt;/b&gt; on a private dashboard,&lt;br&gt;behind a sign-in." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#173326;strokeColor=#5fd38d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="1020" width="380" height="74" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;No:&lt;/b&gt; turned away, nothing saved.&lt;br&gt;The intake program is the only&lt;br&gt;way into the database." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="366.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;No:&lt;/b&gt; turned away, with the&lt;br&gt;problems listed. Unknown kinds&lt;br&gt;of update are refused here." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="640.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Payments and forms&lt;/b&gt; arrive by their&lt;br&gt;own doors, each signature-checked,&lt;br&gt;and join at the same save." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="115.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Retries are safe.&lt;/b&gt; A payment sent&lt;br&gt;twice is still saved once." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="777.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="s" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="a" target="q0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="q0" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="b" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="q1" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="d" target="z"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="q0" target="n0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="q1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="n2" target="s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="n3" target="c"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>